{
  "locale": "ko",
  "language": {
    "primary": "en",
    "secondary": "ko",
    "translate_debate": true,
    "translation_model": "auto"
  },
  "pipeline_config": {
    "test_pmids": ["40315330", "32416070"],
    "llm_server": {
      "url": "http://REDACTED-HOST-X86:11434",
      "failover_url": "http://REDACTED-HOST-X86:11435",
      "model": "auto",
      "timeout": 259200,
      "max_retries": 3
    },
    "container_runtime": {
      "preferred": "apptainer",
      "fallback": "singularity"
    },
    "nextflow": {
      "work_dir": "/workspace/nextflow_work",
      "cache_dir": "/workspace/containers",
      "timeout_hours": {
        "scrnaseq": 4,
        "rnaseq": 3
      }
    },
    "sra_download": {
      "max_parallel": 4,
      "timeout_minutes": 30,
      "max_samples": 50
    }
  },
  "llm_providers": {
    "backends": {
      "ollama": {
        "enabled": true,
        "url": "http://REDACTED-HOST-X86:11434",
        "failover_url": "http://REDACTED-HOST-X86:11435",
        "model": "auto",
        "timeout": 259200,
        "max_retries": 3,
        "max_tokens": 4096,
        "temperature": 0.1,
        "top_p": 0.9
      },
      "openai": {
        "enabled": false,
        "api_key_env": "OPENAI_API_KEY",
        "base_url": null,
        "model": "gpt-4",
        "timeout": 120,
        "max_retries": 3,
        "max_tokens": 4096,
        "temperature": 0.1,
        "top_p": 0.9
      },
      "anthropic": {
        "enabled": false,
        "api_key_env": "ANTHROPIC_API_KEY",
        "model": "claude-sonnet-4-20250514",
        "timeout": 120,
        "max_retries": 3,
        "max_tokens": 4096,
        "temperature": 0.1,
        "top_p": 0.9
      }
    },
    "router": {
      "strategy": "priority",
      "priority_order": ["ollama", "openai", "anthropic"],
      "enable_auto_failover": true,
      "health_check_interval": 60,
      "max_concurrent_requests": 10
    }
  },
  "data_sources": {
    "semantic_scholar": {
      "base_url": "https://api.semanticscholar.org",
      "api_key": null,
      "timeout": 30,
      "rate_limit_delay": 1.0
    },
    "europe_pmc": {
      "base_url": "https://www.ebi.ac.uk/europepmc/webservices/rest",
      "timeout": 30,
      "rate_limit_delay": 0.5
    },
    "annotation": {
      "ensembl_base": "https://rest.ensembl.org",
      "quickgo_base": "https://www.ebi.ac.uk/QuickGO/services",
      "kegg_base": "https://rest.kegg.jp",
      "timeout": 30,
      "rate_limit_delay": 0.35
    },
    "tcga_gdc": {
      "base_url": "https://api.gdc.cancer.gov",
      "timeout": 60,
      "rate_limit_delay": 0.5
    }
  },
  "debate": {
    "num_rounds": 3,
    "consensus_threshold": 0.7,
    "enable_cross_examination": true,
    "timeout_per_agent": 259200,
    "parallel_assessment": false,
    "specialist_max_rounds": 1,
    "agent_weights": {
      "phd_expert": 0.20,
      "undergraduate": 0.12,
      "layperson": 0.08,
      "statistical_skeptic": 0.18,
      "biological_realist": 0.15,
      "experimental_critic": 0.13,
      "translation_evaluator": 0.14
    }
  },
  "research_evaluation": {
    "enabled": true,
    "meta_agent_enabled": true,
    "dimensions": {
      "literature_redundancy": {"weight": 20},
      "data_support": {"weight": 25},
      "cross_dataset_reproducibility": {"weight": 20},
      "biological_plausibility": {"weight": 15},
      "technical_feasibility": {"weight": 10},
      "clinical_industrial_impact": {"weight": 10}
    },
    "verdict_thresholds": {"go": 75, "revise": 45, "drop": 0}
  },
  "enrichment": {
    "gsea_gene_set_db": "KEGG_2021_Human",
    "organism": "human",
    "deg_fc_threshold": 1.5,
    "deg_padj_threshold": 0.05,
    "top_pathways_count": 10,
    "top_genes_count": 50
  },
  "directories": {
    "raw_data": "./results/raw_data",
    "processed_data": "./results/processed_data",
    "nextflow_work": "./results/nextflow_work",
    "containers": "./results/containers",
    "results": "./results",
    "logs": "./results/logs",
    "research_projects": "./research_projects"
  },
  "brave_search": {
    "api_key_env": "BRAVE_API_KEY",
    "timeout": 15,
    "results_per_query": 10,
    "enabled": false
  },
  "rag": {
    "enabled": true,
    "persist_dir": "./results/rag_db",
    "embedding_model": "all-MiniLM-L6-v2",
    "max_context_tokens": 1500
  },
  "search": {
    "limit_per_source": 20,
    "pubmed_enabled": true,
    "semantic_scholar_enabled": true,
    "europe_pmc_enabled": true,
    "brave_enabled": false
  },
  "nextflow_execution": {
    "enabled": false,
    "work_dir": "./nextflow_work",
    "outdir": "./results/nfcore",
    "container_runtime": "docker",
    "profile": "docker",
    "genome": "GRCh38",
    "max_memory": "16.GB",
    "max_cpus": 4,
    "max_time": "24.h",
    "resume": true,
    "fetchngs": {
      "enabled": true,
      "download_method": "sratools"
    },
    "slurm": {
      "enabled": false,
      "queue": "",
      "account": "",
      "qos": "",
      "time_limit": "24:00:00",
      "memory": "16G",
      "cpus_per_task": 4,
      "nodes": 1,
      "extra_args": "",
      "submit_rate_limit": "50/2min",
      "queue_size": 100,
      "cluster_options": ""
    },
    "organism_detection": {
      "enabled": true,
      "fallback_genome": "GRCh38",
      "override_genome": null
    },
    "pipeline_params": {
      "nf-core/rnaseq": {
        "pseudo_aligner": "salmon",
        "aligner": "star_salmon",
        "trimmer": "trimgalore",
        "skip_trimming": false,
        "with_umi": false,
        "min_mapped_reads": 5
      },
      "nf-core/scrnaseq": {
        "protocol": "10XV3",
        "aligner": "cellranger",
        "skip_emptydrops": false
      },
      "nf-core/atacseq": {
        "narrow_peak": true,
        "broad_cutoff": 0.1,
        "min_reps_consensus": 1
      },
      "nf-core/chipseq": {
        "narrow_peak": true,
        "broad_cutoff": 0.1,
        "min_reps_consensus": 1
      },
      "nf-core/sarek": {
        "tools": "strelka,snpeff",
        "step": "mapping",
        "wes": false
      },
      "nf-core/methylseq": {
        "aligner": "bismark",
        "comprehensive": true,
        "rrbs": false
      },
      "nf-core/cutandrun": {
        "peakcaller": "seacr",
        "use_control": true
      },
      "nf-core/rnafusion": {
        "tools": "arriba,starfusion",
        "all": false
      }
    }
  },
  "analysis": {
    "r_executable": "Rscript",
    "r_scripts_dir": null,
    "scanpy_enabled": false,
    "deseq2": {
      "fc_threshold": "1.5",
      "padj_threshold": "0.05"
    },
    "seurat": {
      "min_features": "200",
      "max_features": "5000",
      "max_mt_percent": "20",
      "resolution": "0.8"
    }
  },
  "execution": {
    "resume_enabled": true,
    "progress_file": "./results/progress.json",
    "log_level": "ERROR",
    "dry_run_first": true,
    "max_concurrent": 5,
    "enable_debate": true,
    "enable_enrichment": true,
    "enable_data_aggregation": true
  },
  "sequencing_detection": {
    "scrna_keywords": [
      "single-cell", "single cell", "singlecell",
      "scrna-seq", "single-cell rna sequencing",
      "10x genomics", "drop-seq", "smart-seq",
      "cell ranger", "cellranger",
      "droplet", "microfluidic", "cell barcoding",
      "umis", "unique molecular identifiers"
    ],
    "bulk_keywords": [
      "bulk rna-seq", "bulk rna sequencing",
      "rna-seq", "rna sequencing",
      "transcriptome", "gene expression",
      "polya", "poly-a selection"
    ],
    "wgs_keywords": [
      "whole genome sequencing", "wgs", "whole exome", "wes",
      "variant calling", "somatic mutation"
    ],
    "methylseq_keywords": [
      "bisulfite", "methylation", "wgbs", "rrbs",
      "dna methylation", "cpg"
    ],
    "cutandrun_keywords": [
      "cut&run", "cut&tag", "cutandrun", "cutandtag",
      "cleavage under targets"
    ],
    "rnafusion_keywords": [
      "gene fusion", "fusion gene", "chimeric transcript",
      "chromosomal translocation"
    ]
  },
  "expected_results": {
    "40315330": {
      "expected_type": "scRNA-seq",
      "expected_pipeline": "nf-core/scrnaseq"
    },
    "32416070": {
      "expected_type": "bulk RNA-seq",
      "expected_pipeline": "nf-core/rnaseq"
    },
    "test_wgs": {
      "expected_type": "WGS/WES",
      "expected_pipeline": "nf-core/sarek"
    }
  }
}
