
# Nextflow Configuration for scrnaseq
# Generated at 2026-01-11T09:25:09.706717

workDir = '/workspace/nextflow_work'
cacheDir = '/workspace/containers'

# Process 설정
process {
    executor = 'local'
    cpus = 4
    memory = '16 GB'
    time = '24h'
    
    // 컨테이너 설정
    if (workflow.containerEngine == 'apptainer') {
        container = 'nf-core/scrnaseq:latest'
    }
    
    // 에러 처리
    errorStrategy = 'retry'
    maxRetries = 3
    maxErrors = 5
}

# 실행 설정
timeline {
    enabled = true
    file = '/workspace/results/timeline_scrnaseq.html'
}

trace {
    enabled = true
    file = '/workspace/results/trace_scrnaseq.txt'
}

report {
    enabled = true
    file = '/workspace/results/report_scrnaseq.html'
}
