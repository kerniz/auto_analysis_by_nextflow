
# Nextflow Configuration for scrnaseq
# Generated at 2026-01-11T09:25:09.706717

// workDir/cacheDir: Nextflow 시스템 기본값 사용
// (NXF_WORK 환경변수 또는 ./work, NXF_SINGULARITY_CACHEDIR 환경변수로 오버라이드 가능)

# Process 설정
process {
    executor = 'local'
    cpus = 4
    memory = '16 GB'
    time = '24h'

    // 컨테이너 설정
    if (workflow.containerEngine == 'apptainer') {
        container = 'nf-core/scrnaseq:latest'
    }

    // 에러 처리
    errorStrategy = 'retry'
    maxRetries = 3
    maxErrors = 5
}

# 실행 설정
timeline {
    enabled = true
    file = 'results/timeline_scrnaseq.html'
}

trace {
    enabled = true
    file = 'results/trace_scrnaseq.txt'
}

report {
    enabled = true
    file = 'results/report_scrnaseq.html'
}
